  <property name="styleSheet"><string notr="true">QDialog#MonthlyApprovedMedicals{background:#F7F1E3;color:#263238;font-family:Inter;font-size:14px;}
QLabel{font-family:Inter;font-size:14px;color:#263238;background:transparent;border:none;}
QFrame#header{background:#7A263A;border:none;}
QLabel#headerBrand{font-size:24px;font-weight:600;color:#D6A21E;}
QLabel#headerUniversity{font-size:11px;color:#FFFDF8;}
QLabel#headerTitle{font-size:21px;font-weight:600;color:#FFFDF8;}
QLabel#headerAudience{font-size:13px;color:#FFFDF8;}
QFrame#filterCard,QFrame#resultsCard{background:#FFFDF8;border:1px solid #DBD1BA;border-radius:10px;}
QLabel#lblSummary{font-size:18px;font-weight:600;color:#7A263A;}
QLabel#lblDescription,QLabel#lblState{font-size:13px;color:#52616B;}
QLabel#lblMonth,QLabel#lblYear{font-size:13px;font-weight:500;}
QComboBox,QSpinBox{font-family:Inter;font-size:14px;color:#263238;background:#FFFDF8;border:1px solid #DBD1BA;border-radius:7px;padding:7px 12px;min-height:26px;}
QComboBox:focus,QSpinBox:focus{border-color:#D6A21E;}
QComboBox QAbstractItemView{color:#263238;background:#FFFDF8;selection-color:#FFFDF8;selection-background-color:#7A263A;}
QToolButton#btnYearPrevious,QToolButton#btnYearNext{font-family:Inter;font-size:20px;font-weight:600;color:#263238;background:#FFFDF8;border:1px solid #DBD1BA;border-radius:7px;padding:0px;}
QToolButton#btnYearPrevious:hover,QToolButton#btnYearPrevious:focus,QToolButton#btnYearNext:hover,QToolButton#btnYearNext:focus{color:#263238;background:#F6E8BD;border-color:#D6A21E;}
QToolButton#btnYearPrevious:disabled,QToolButton#btnYearNext:disabled{color:#9B8D74;background:#EEE6D6;border-color:#DBD1BA;}
QTreeWidget{font-family:Inter;font-size:14px;color:#263238;background:#FFFDF8;border:none;outline:none;selection-color:#263238;selection-background-color:#F6E8BD;}
QTreeWidget::item{padding:9px 10px;border-bottom:1px solid #EEE6D6;}
QTreeWidget::item:selected{color:#263238;background:#F6E8BD;}
QTreeWidget::item:hover{background:#F7F1E3;}
QTreeWidget::item:focus{border:1px solid #D6A21E;}
QHeaderView::section{font-family:Inter;font-size:13px;font-weight:500;color:#FFFDF8;background:#7A263A;border:none;border-right:1px solid #9C5263;padding:12px 16px;}
QPushButton{font-family:Inter;font-size:13px;font-weight:500;color:#FFFDF8;background:#7A263A;border:1px solid #7A263A;border-radius:8px;padding:12px 22px;min-height:20px;}
QPushButton:hover,QPushButton:focus{border-color:#D6A21E;}
QPushButton:pressed{background:#5B1929;}
QPushButton:disabled{color:#61584A;background:#E6DED0;border-color:#C7BDAA;}
QPushButton#btnBack{color:#34270A;background:#D6A21E;border-color:#D6A21E;}
QPushButton#btnBack:hover,QPushButton#btnBack:focus{border-color:#7A263A;}</string></property>
